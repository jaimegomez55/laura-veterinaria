---
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieBanner from '../components/CookieBanner';

interface Faq {
  question: string;
  answer: string;
}

interface RelatedPost {
  title: string;
  description: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  keyword: string;
  keywords?: string[];
  answerBlock?: string;
  ogImage?: string;
  faqs?: Faq[];
  related?: RelatedPost[];
}

const { title, description, pubDate, updatedDate, keyword, keywords, answerBlock, ogImage, faqs, related } = Astro.props;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  keywords: [keyword, ...(keywords ?? [])].join(', '),
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    '@type': 'Person',
    '@id': 'https://lauraquinteroveterinaria.com/#laura',
    name: 'Laura Quintero Álvarez',
    jobTitle: 'Nutricionista veterinaria',
    url: 'https://lauraquinteroveterinaria.com/',
    sameAs: [
      'https://www.linkedin.com/in/laura-quintero-veterinaria/',
      'https://www.instagram.com/laura_quintero_veterinaria/',
      'https://vetesfera.com/autor/laura-quintero-alvarez/',
      'https://aux.streaming.ifevet.com/laura-quintero-alvarez/',
    ],
  },
  publisher: {
    '@type': 'Person',
    '@id': 'https://lauraquinteroveterinaria.com/#laura',
    name: 'Laura Quintero Álvarez',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};

// Schema FAQPage: se genera solo a partir de la sección "Preguntas frecuentes" del artículo
const faqSchema = faqs && faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const jsonLd = faqSchema ? [blogPostingSchema, faqSchema] : [blogPostingSchema];
---
<Base title={title} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  <Navbar />

  <article class="min-h-screen bg-white">
    <div class="container mx-auto px-6 py-24 lg:py-32 max-w-3xl">

      <!-- Metadatos del artículo -->
      <header class="mb-12">
        <time datetime={pubDate.toISOString()}
          class="text-sm text-[#bad7f2] font-semibold uppercase tracking-widest"
        >
          {pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <h1 class="text-4xl lg:text-5xl font-bold text-[#1e3a5f] mt-3 mb-6 leading-tight">
          {title}
        </h1>
        <div class="w-20 h-1 bg-[#f2bac9]"></div>
      </header>

      <!-- Bloque de respuesta directa (AEO) -->
      {answerBlock && (
        <div class="bg-gradient-to-br from-[#bad7f2]/20 to-[#f2bac9]/20 border-l-4 border-[#f2bac9] rounded-r-xl p-6 mb-10">
          <p class="text-lg text-[#1e3a5f] leading-relaxed font-medium">{answerBlock}</p>
        </div>
      )}

      <!-- Contenido del artículo -->
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed
        prose-headings:text-[#1e3a5f] prose-headings:font-bold
        prose-a:text-[#f2bac9] prose-a:no-underline hover:prose-a:underline
        prose-strong:text-[#1e3a5f]">
        <slot />
      </div>

      <!-- CTA al final del artículo -->
      <div class="mt-16 bg-gradient-to-br from-[#bad7f2] to-[#f2bac9] rounded-2xl p-8 text-center">
        <p class="text-white font-semibold text-xl mb-4">¿Tienes dudas sobre la alimentación de tu perro?</p>
        <a href="https://calendly.com/laura-quintero-vet/llamada-gratuita-informacion"
          class="inline-block bg-white text-[#1e3a5f] font-bold px-8 py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300"
        >
          Agenda una llamada gratuita
        </a>
      </div>

      <!-- Artículos relacionados (enlazado interno) -->
      {related && related.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-bold text-[#1e3a5f] mb-6">Sigue leyendo</h2>
          <div class="grid gap-4">
            {related.map((r) => (
              <a href={r.href} class="block rounded-xl border border-gray-100 bg-white p-5 shadow-sm hover:shadow-md transition-shadow">
                <p class="font-semibold text-[#1e3a5f]">{r.title}</p>
                <p class="text-sm text-gray-600 mt-1">{r.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </article>

  <Footer />
  <WhatsAppButton />
  <CookieBanner client:load />
</Base>
