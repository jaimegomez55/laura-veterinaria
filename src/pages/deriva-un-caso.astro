---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieBanner from '../components/CookieBanner';
import ReferralForm from '../components/ReferralForm';
---
<Base
  title="Deriva un caso de nutrición veterinaria | Laura Quintero"
  description="Sistema de derivación para veterinarios y clínicas. Envía los datos del paciente y recibe una valoración nutricional personalizada en menos de 48 horas."
>
  <Navbar />

  <!-- Hero estático -->
  <section class="pt-32 pb-20 px-6 lg:px-12 bg-gradient-to-br from-[#bad7f2]/20 to-[#f2bac9]/20 relative overflow-hidden text-center">
    <div class="absolute -top-20 -right-20 w-[300px] h-[300px] rounded-full bg-[#f2bac9]/20 blur-3xl"></div>
    <div class="absolute -bottom-16 -left-16 w-[200px] h-[200px] rounded-full bg-[#bad7f2]/30 blur-2xl"></div>

    <div class="max-w-4xl mx-auto relative z-10">
      <span class="inline-block bg-white text-[#f2bac9] text-xs font-bold tracking-widest uppercase px-4 py-2 rounded-full shadow-sm mb-6">
        Para veterinarios
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#1e3a5f] mb-6 leading-tight">
        Deriva un caso de nutrición
      </h1>
      <p class="text-xl text-[#1e3a5f]/80 max-w-2xl mx-auto mb-10 leading-relaxed font-['Merriweather']">
        Envíame los datos del paciente y te respondo en menos de 48h con una valoración nutricional personalizada.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {['📋 Respuesta en 48h', '🔒 Datos protegidos', '📎 Adjunta analíticas', '🐾 Perros y gatos'].map((pill) => (
          <span class="bg-white border border-[#E8E4DD] text-[#1e3a5f] text-sm font-medium px-4 py-2 rounded-full shadow-sm flex items-center gap-2">
            {pill}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Formulario (Astro Island) -->
  <main class="max-w-[800px] mx-auto pt-16 pb-24 px-4 md:px-6">
    <ReferralForm client:load />
  </main>

  <Footer />
  <WhatsAppButton />
  <CookieBanner client:load />
</Base>
