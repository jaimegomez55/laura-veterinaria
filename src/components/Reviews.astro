---
import ReviewsCarousel from './ReviewsCarousel';

const PROFILE_URL = 'https://maps.app.goo.gl/LZgHbw1DjtuZj5nF6';
---
<section id="reviews" class="py-20 bg-white">
  <div class="container mx-auto px-6 lg:px-12">

    <!-- Encabezado estático -->
    <div class="text-center mb-10">
      <h2 class="text-4xl lg:text-5xl font-bold text-[#1e3a5f] mb-4">
        La experiencia de quienes ya han confiado en este proceso
      </h2>
      <div class="w-20 h-1 bg-[#f2bac9] mx-auto mb-6"></div>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Experiencias reales de personas que confiaron en una consulta online para mejorar la salud de su perro.
      </p>
    </div>

    <!-- Badge Google Aggregate -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex items-center gap-3 bg-gray-50 border border-gray-200 rounded-xl px-6 py-4 shadow-sm">
        <!-- Google G SVG -->
        <svg viewBox="0 0 24 24" class="w-6 h-6" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-2xl font-bold text-gray-800 leading-none">5,0</span>
            <div class="flex gap-0.5">
              {Array.from({ length: 5 }).map(() => (
                <svg viewBox="0 0 20 20" class="w-4 h-4 flex-shrink-0" fill="#F9AB00" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
          </div>
          <p class="text-xs text-gray-500 mt-0.5">
            Basado en 6 reseñas en
            <span class="font-medium" style="font-family: arial, sans-serif;">
              <span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span>
            </span>
          </p>
        </div>
      </div>
    </div>

    <!-- Carrusel interactivo (Astro Island) -->
    <ReviewsCarousel client:visible />

    <!-- CTA Google reviews -->
    <div class="flex justify-center mt-10">
      <a
        href={PROFILE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-gray-300 hover:border-gray-400 bg-white hover:bg-gray-50 text-gray-700 font-medium px-6 py-3 rounded-lg shadow-sm hover:shadow-md transition-all duration-200"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Ver todas las reseñas en
        <span class="font-medium" style="font-family: arial, sans-serif;">
          <span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span>
        </span>
      </a>
    </div>

    <!-- CTA Calendly -->
    <div class="text-center mt-12">
      <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-6">
        ¿Te ves reflejado en estas experiencias? Agenda una llamada gratuita y cuéntame tu caso.
      </p>
      <div class="flex justify-center">
        <a
          href="https://calendly.com/laura-quintero-vet/llamada-gratuita-informacion?month=2025-12"
          class="inline-block bg-[#ff6b5a] hover:bg-[#ff5544] text-white font-semibold px-10 py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 whitespace-nowrap"
        >
          Agenda una llamada gratuita
        </a>
      </div>
    </div>

  </div>
</section>
