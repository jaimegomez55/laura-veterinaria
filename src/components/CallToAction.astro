---
---
<section id="cta" class="py-20 bg-gradient-to-br from-[#bad7f2] to-[#f2bac9]">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="max-w-4xl mx-auto text-center">

      <div class="w-20 h-20 flex items-center justify-center bg-white rounded-full mx-auto mb-8 shadow-lg">
        <i class="ri-heart-fill text-5xl text-[#f2bac9]"></i>
      </div>

      <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
        No tienes que tomar decisiones solo.
      </h2>

      <p class="text-xl text-white/90 mb-10 leading-relaxed max-w-2xl mx-auto">
        Agenda una llamada gratuita y hablamos de tu caso sin compromiso.
      </p>

      <div class="flex justify-center">
        <a
          href="https://calendly.com/laura-quintero-vet/llamada-gratuita-informacion"
          class="inline-block bg-[#ff6b5a] hover:bg-[#ff5544] text-white font-semibold px-10 py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 whitespace-nowrap"
        >
          Agenda una llamada gratuita
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 max-w-2xl mx-auto">
        <div class="text-center">
          <div class="w-16 h-16 flex items-center justify-center bg-white rounded-full mx-auto mb-4">
            <i class="ri-phone-fill text-3xl text-[#bad7f2]"></i>
          </div>
          <p class="text-white font-semibold">+34 634359766</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 flex items-center justify-center bg-white rounded-full mx-auto mb-4">
            <i class="ri-mail-fill text-3xl text-[#f2bac9]"></i>
          </div>
          <p class="text-white font-semibold">laura.quintero.vet@gmail.com</p>
        </div>
      </div>

    </div>
  </div>
</section>
