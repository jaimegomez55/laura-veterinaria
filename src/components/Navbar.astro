---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const navItems = [
  { name: 'Sobre Mí', href: isHome ? '#about' : '/#about' },
  { name: 'Servicios', href: isHome ? '#services' : '/#services' },
  { name: 'Deriva un caso', href: '/deriva-un-caso' },
  { name: 'Calculadora', href: '/calculadora' },
  { name: 'Blog', href: '/blog' },
  { name: 'Reseñas', href: isHome ? '#reviews' : '/#reviews' },
  { name: 'Casos de Éxito', href: isHome ? '#success-stories' : '/#success-stories' },
  { name: 'Preguntas', href: isHome ? '#faq' : '/#faq' },
];

const contactarHref = isHome ? '#cta' : '/#cta';
---
<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent py-6"
>
  <div class="container mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between">

      <!-- Todo agrupado a la izquierda: logo + páginas reales -->
      <div class="flex items-center gap-6">
        <a href="/" class="flex items-center gap-2 group flex-shrink-0 whitespace-nowrap">
          <div class="w-12 h-12 flex items-center justify-center">
            <Image
              src={logoImg}
              alt="Logo Laura Quintero"
              width={48}
              height={48}
              class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <span class="text-2xl font-bold text-[#1e3a5f]" style="font-family: 'Pacifico', serif;">
            Laura Quintero
          </span>
        </a>

        <!-- Enlaces a páginas reales (no son anclas de la home) -->
        <div class="hidden md:flex items-center gap-6">
          <a href="/calculadora" class="text-[#1e3a5f] hover:text-[#f2bac9] font-medium transition-colors whitespace-nowrap">
            Calculadora
          </a>
          <a href="/deriva-un-caso" class="text-[#1e3a5f] hover:text-[#f2bac9] font-medium transition-colors whitespace-nowrap">
            Deriva un caso
          </a>
          <a href="/blog" class="text-[#1e3a5f] hover:text-[#f2bac9] font-medium transition-colors whitespace-nowrap">
            Blog
          </a>
        </div>
      </div>

      <!-- Menú + CTA agrupados a la derecha -->
      <div class="flex items-center gap-4">

        <!-- Botón de menú (visible en cualquier tamaño de pantalla) -->
        <button
          id="menu-btn"
          class="flex items-center gap-2 p-2 md:px-4 md:py-2 md:rounded-lg md:hover:bg-gray-100 text-[#1e3a5f] transition-colors"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <i id="menu-icon" class="ri-menu-line text-2xl"></i>
          <span class="hidden md:inline text-sm font-medium">Menú</span>
        </button>

        <a href={contactarHref}
          class="hidden md:inline-block bg-[#f2bac9] hover:bg-[#bad7f2] text-white font-semibold px-6 py-3 rounded-lg transition-all duration-300 whitespace-nowrap"
        >
          Contactar
        </a>
      </div>
    </div>

    <!-- Menú desplegable (mismo panel para móvil y desktop) -->
    <div
      id="mobile-menu"
      class="hidden mt-4 pb-4 border-t border-gray-200 bg-white rounded-lg shadow-md"
    >
      <div class="flex flex-col gap-4 pt-4">
        {navItems.map((item) => (
          <a href={item.href}
            class="text-[#1e3a5f] hover:text-[#f2bac9] font-medium transition-colors px-2"
            data-mobile-link
          >
            {item.name}
          </a>
        ))}
        <a href={contactarHref}
          class="bg-[#f2bac9] hover:bg-[#bad7f2] text-white font-semibold px-6 py-3 rounded-lg transition-all duration-300 text-center"
          data-mobile-link
        >
          Contactar
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  const menuBtn = document.getElementById('menu-btn');
  const menuIcon = document.getElementById('menu-icon');
  const mobileMenu = document.getElementById('mobile-menu');

  function setScrolled(scrolled: boolean) {
    if (!nav) return;
    if (scrolled) {
      nav.classList.add('bg-white', 'shadow-lg', 'py-4');
      nav.classList.remove('bg-transparent', 'py-6');
    } else {
      nav.classList.remove('bg-white', 'shadow-lg', 'py-4');
      nav.classList.add('bg-transparent', 'py-6');
    }
  }

  window.addEventListener('scroll', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;
    setScrolled(window.scrollY > 50 || isOpen);
  });

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIcon?.classList.replace('ri-close-line', 'ri-menu-line');
      menuBtn.setAttribute('aria-expanded', 'false');
      if (window.scrollY <= 50) setScrolled(false);
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIcon?.classList.replace('ri-menu-line', 'ri-close-line');
      menuBtn.setAttribute('aria-expanded', 'true');
      setScrolled(true);
    }
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIcon?.classList.replace('ri-close-line', 'ri-menu-line');
      menuBtn?.setAttribute('aria-expanded', 'false');
      if (window.scrollY <= 50) setScrolled(false);
    });
  });
</script>
